# ==============================================================================
# KPI Intelligence — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Storage Backend Selection
# ------------------------------------------------------------------------------
# KPI_ENVIRONMENT options: development, test, staging, production
# Note: In staging and production, KPI_STORAGE_BACKEND MUST be 'cosmos'.
# Attempting to start in production or staging with 'sqlite' will raise a fatal error.
KPI_ENVIRONMENT=development

# KPI_STORAGE_BACKEND options: sqlite, cosmos
# Default in development/test: sqlite
# Default in staging/production: cosmos
KPI_STORAGE_BACKEND=sqlite

# ------------------------------------------------------------------------------
# 2. Local SQLite Configuration (Development / Testing Only)
# ------------------------------------------------------------------------------
KPI_SQLITE_PATH=local_data/kpi_intelligence.sqlite3

# ------------------------------------------------------------------------------
# 3. Azure Cosmos DB for NoSQL Configuration (Production / Staging)
# ------------------------------------------------------------------------------
# Cosmos DB Account URI Endpoint
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/

# Target Database Name
COSMOS_DATABASE=kpi_intelligence

# Authentication Mode
# In Azure environments (App Service, AKS, Azure Functions), set to true
# and assign 'Cosmos DB Built-in Data Contributor' to the system-assigned managed identity.
COSMOS_USE_MANAGED_IDENTITY=true

# Master Key (ONLY for local Cosmos DB Emulator or automated integration testing)
# Leave empty when using Managed Identity.
COSMOS_KEY=

# Client Connection & Throttling Resilience Settings
COSMOS_MAX_RETRIES=5
COSMOS_RETRY_DELAY_SECONDS=0.5
COSMOS_CONNECTION_TIMEOUT=10
